              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          ]
        },
        "event": {
          "enum": [
            "ROOT_ADMITTED",
            "CHILD_MINTED",
            "REQUEST_PROVED",
            "CERTIFICATE_ISSUED",
            "CHECKED",
            "REDEEMED",
            "RECOVERED_REDEMPTION",
            "DELIVERY_HELD",
            "DELIVERY_UNCERTAIN",
            "RESPONSE_CHALLENGED",
            "RESPONSE_PROVED",
            "CUSTODIAN_OUTCOME",
            "BROKER_CONFIRMED",
            "GRANT_REVOKED",
            "EXPIRED",
            "WALLET_PROPOSAL_RECORDED",
            "WALLET_PROPOSAL_REFUSED",
            "FAILURE_RESPONSE_CHALLENGED",
            "FAILURE_RESPONSE_PROVED"

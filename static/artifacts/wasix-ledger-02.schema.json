        "actor": {
          "type": "string"
        },
        "op": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
        },
        "ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "seq",
        "event",
        "actor",
        "op",
        "channel",
        "data",
        "signature",
        "ref"
      ]
    },

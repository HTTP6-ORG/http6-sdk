{
  "name": "http6-sdk-proposal-workspace",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "docs:prepare": "node scripts/build-openapi.mjs && node scripts/prepare-docs.mjs",
    "start": "npm run docs:prepare && docusaurus start --host 127.0.0.1",
    "build": "npm run docs:prepare && docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1",
    "test": "node --test packages/sdk/test/*.test.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swagger-ui-dist": "5.36.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "serialize-javascript": "7.1.3",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
